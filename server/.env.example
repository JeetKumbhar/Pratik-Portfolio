# Copy this file to .env and fill it in. NEVER commit .env.
PORT=5000
NODE_ENV=development

# Atlas → Connect → Drivers → copy the string, then add the database name before the "?"
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F, : → %3A)
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>.mongodb.net/alex-morgan?retryWrites=true&w=majority

# The frontend address (CORS)
CLIENT_URL=http://localhost:5173

# The photographer's timezone (IANA name). "After today" in bookings is judged in this timezone.
# e.g. America/Edmonton, Europe/London, Asia/Kolkata
BUSINESS_TIMEZONE=UTC

# Where "new booking request" alerts go (defaults to ADMIN_EMAIL). Emails print in the terminal until SMTP is set up.
# NOTIFY_EMAIL=

# Used by `npm run seed` to create the first admin
ADMIN_NAME=Alex Morgan
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-something-long

# Later phases
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Email (optional; without these, emails are printed in the terminal instead)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Alex Morgan Photography <hello@alexmorgan.com>"

# ---------- WhatsApp notifications (official WhatsApp Business Platform, Cloud API). See docs/WHATSAPP_SETUP.md ----------
# Leave these empty and everything else works: WhatsApp messages are simply not sent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The Graph API version shown in your Meta app / changelog, like v25.0 (Meta retires old versions)
WHATSAPP_API_VERSION=
# Your own WhatsApp number WITH country code, digits only, e.g. 919876543210
PHOTOGRAPHER_WHATSAPP_NUMBER=
PHOTOGRAPHER_NAME=Alex Morgan
# Must match the language you chose when creating the templates (en or en_US)
WHATSAPP_TEMPLATE_LANGUAGE=en
# Optional: lets customers type a local number without "+" (e.g. 91 for India)
WHATSAPP_DEFAULT_COUNTRY_CODE=
# Webhook (delivery status + STOP replies): your Meta App Secret, and any long random text you also paste into Meta's webhook form
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
