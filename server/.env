# Copy this file to .env and fill it in. NEVER commit .env.
PORT=5000
NODE_ENV=development

# Atlas → Connect → Drivers → copy the string, then add the database name before the "?"
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F, : → %3A)
MONGO_URI=mongodb+srv://jeetkumbhar2210_db_user:vPkUGT1RaAxlfAdJ@pratiks-portfolio.6ct5hrw.mongodb.net/jeetkumbhar2210_db?retryWrites=true&w=majority
# The frontend address (CORS)
CLIENT_URL=http://localhost:5173

# The photographer's timezone (IANA name). "After today" in bookings is judged in this timezone.
# e.g. America/Edmonton, Europe/London, Asia/Kolkata
BUSINESS_TIMEZONE=UTC

